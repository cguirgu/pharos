# Pharos backend + auth keys. Copy to `.env` (gitignored) and fill in, or set as
# EAS secrets for cloud builds. When SUPABASE_URL + SUPABASE_ANON_KEY are present
# the app runs against Supabase with Google sign-in; otherwise it falls back to a
# local dev store + local dev sign-in (so it still runs in Expo Go without keys).
# See docs/BACKEND-SETUP.md for where each value comes from.

# Supabase project (Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth (Google Cloud Console → Credentials)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# The iOS reversed client id, e.g. com.googleusercontent.apps.1234567890-abcdef
GOOGLE_IOS_URL_SCHEME=
