# Pharos backend + auth keys. Copy to `.env` (gitignored) and fill in, or set as
# EAS secrets for cloud builds. When SUPABASE_URL + SUPABASE_ANON_KEY are present
# the app runs against Supabase (Sign in with Apple + email/password); otherwise
# it falls back to a local dev store (so it still runs in Expo Go without keys).
# See docs/BACKEND-SETUP.md for where each value comes from.

# Supabase project (Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
